{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "verify/*.ts"
  ]
}